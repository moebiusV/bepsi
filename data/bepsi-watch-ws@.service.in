[Unit]
# One instance per source: bepsi-watch-ws@lightning, bepsi-watch-ws@arkade.
# Each reads /etc/bepsi/watch-<instance>.conf.
Description=Bepsi payment watcher (%i)
Documentation=https://github.com/moebiusV/bepsi
After=network-online.target bepsid.service
Wants=network-online.target bepsid.service

[Service]
Type=simple
User=bepsi-watch
Group=bepsi-watch
# Group bepsi lets it reach the bepsid socket; it has no GPIO or database access.
SupplementaryGroups=bepsi
ExecStart=@sbindir@/bepsi-watch-ws -c @sysconfdir@/bepsi/watch-%i.conf
Restart=always
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
