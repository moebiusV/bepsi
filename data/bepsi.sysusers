# Service user and group for the bepsi daemons.  Members of group bepsi can
# connect to the bepsid socket; add the watcher and web users to it.
g gpio - -
u bepsi - "Bepsi vending machine" /var/lib/bepsi
# The payment watchers run as their own user, in group bepsi only to reach the
# bepsid socket.
u bepsi-watch - "Bepsi payment watchers" /var/empty
m bepsi-watch bepsi
# The web server runs as its own user too; the CGI pages it starts inherit it.
u bepsi-web - "Bepsi web server" /var/empty
m bepsi-web bepsi
# The low-hopper alert runs as its own user too.
u bepsi-notify - "Bepsi hopper alerts" /var/empty
m bepsi-notify bepsi
