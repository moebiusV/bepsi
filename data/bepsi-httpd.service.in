[Unit]
Description=Bepsi web server (HTTPS tablet UI)
Documentation=https://github.com/moebiusV/bepsi
After=network-online.target bepsid.service
Wants=network-online.target bepsid.service

[Service]
Type=simple
User=bepsi-web
Group=bepsi-web
# Group bepsi lets the CGI pages it runs reach the bepsid socket; the web
# server itself has no GPIO or database access.
SupplementaryGroups=bepsi
ExecStart=@sbindir@/bepsi-httpd @sysconfdir@/bepsi/httpd.conf
Restart=on-failure
RestartSec=3
# Only to bind port 443.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
